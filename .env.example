# ==============================================================================
# AUTOMATED DEPLOYMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' before launching the system:
#   cp .env.example .env
# ==============================================================================

# --- Server Ports ---
API_PORT=9000
PROXY_PORT=8000
NODE_ENV=development

# --- Storage Configuration ---
# Options: 'local' (zero-config in-memory/disk emulator) or 'aws' (Amazon S3)
STORAGE_MODE=local

# --- AWS Cloud Credentials (Required only when STORAGE_MODE=aws) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=automated-deployment-bucket

# --- AWS ECS Cluster Configuration (For Cloud Worker Deployments) ---
AWS_ECS_CLUSTER=production-cluster
AWS_ECS_TASK_FAMILY=automated-deployment-build-task

# --- Redis Configuration ---
# Leave blank to use the high-performance in-memory fallback emulator
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Build Worker Tuning ---
BUILD_TIMEOUT_MS=120000
GIT_CLONE_TIMEOUT_MS=60000

# --- Logging & Observability ---
# Options: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
ENABLE_METRICS=true
