# ==============================================================================
# AUTOMATED DEPLOYMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' before launching the system:
#   cp .env.example .env
#
# Zero-Cloud Mode:
# When STORAGE_MODE=local and REDIS_URL is unset, all tests and servers run
# 100% offline with in-memory Redis and local disk S3 emulation.
# ==============================================================================

# --- Server Ports & Host Binding ---
PORT=3000
API_PORT=9000
PROXY_PORT=8000
NODE_ENV=development
UNIFIED_SERVER=true
BASE_URL=http://localhost:3000
TUNNEL_URL=

# --- Storage Configuration ---
# Options: 'local' (zero-config local disk S3 emulator) or 'aws' (Amazon S3)
STORAGE_MODE=local

# --- AWS Cloud Credentials (Required only when STORAGE_MODE=aws) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=automated-deployment-bucket

# --- AWS ECS Cluster Configuration (For Cloud Worker Deployments) ---
AWS_ECS_CLUSTER=production-cluster
AWS_ECS_TASK_FAMILY=automated-deployment-build-task

# --- Redis Configuration ---
# Leave blank to use the high-performance zero-config in-memory emulator
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Build Worker & Container Environment Variables ---
DEPLOYMENT_ID=
PROJECT_SLUG=sample-app
GIT_REPOSITORY_URL=
TEMPLATE_ID=
GIT_BRANCH=main
BUILD_COMMAND=
INSTALL_COMMAND=
OUTPUT_DIR=dist
BUILD_TIMEOUT_MS=120000
GIT_CLONE_TIMEOUT_MS=60000

# --- Logging, Observability & Error Tracking ---
# LOG_LEVEL: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
# LOG_FORMAT: 'text' (default human-readable) or 'json' (structured JSON logs)
LOG_FORMAT=text
ENABLE_METRICS=true
# Optional Sentry DSN for error reporting
SENTRY_DSN=
